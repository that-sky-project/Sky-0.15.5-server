# =====================================================================
# 光遇私服 wbsky · 部署环境变量（模板）
# ---------------------------------------------------------------------
# 真名是 .env（不带 .example），Compose 会自动读。
# 本文件必须是**无 BOM 的 UTF-8**（Windows 编辑器很容易加 BOM，
# 加了之后 Docker 读第一行会报 "unexpected character"）。
#
# 用法：
#   cp deploy/.env.example deploy/.env    # 然后按下面注释改
#
# 只要端口 / 域名 / 数据库变了，**绝大部分改动都在这个文件里**。
#
# 注意：下面的值**不要写行尾注释**。Compose 对 env_file 里行尾注释的处理
# 和 shell 不一样（引号内更不会剥），"2007  # 主服务" 这种写法会把
# 整个字符串当成端口值。注释一律写在上一行。
# =====================================================================

# ---------------------------------------------------------------------
# 一、对外端口
# ---------------------------------------------------------------------
# 本包把容器内端口**配成与宿主机一致**（2007 / 19458 / 2500 / 11925），
# 这样 `docker exec` 里自查、以及排障手册里的命令都能直接照抄。
# （历史上容器内固定 2999/9002，跟宿主机不一致，排障时很容易搞混。）
# 改了任意一个，记得同步三处：
#   1) 云厂商安全组
#   2) 1Panel 防火墙
#   3) 如果走 nginx 反代：deploy/nginx/*.conf 里的 proxy_pass 端口
#
# 主服务（客户端 API + /live 面板）
HTTPS_PORT=2007
# 联机房间服（纯 UDP，反代无效）
UDP_PORT=19458
# 聊天 WebSocket（也可以不对外暴露，走 nginx 反代 /account/ws）
WS_PORT=2500
# 房间服 /health 与 /stats，只绑 127.0.0.1，不给公网
STATS_PORT=11925

# 说明：本房间服是"一图一房"（同一个 UDP 端口内按关卡分组），
# 不是"一房一端口"，所以**不需要** UDP 端口段，只映射一个端口即可。
# （如果哪天换成每房递增端口的多实例方案，再来这里加 UDP_PORT_END。）


# ---------------------------------------------------------------------
# 二、域名 / 对外地址
# ---------------------------------------------------------------------
# 主域名（客户端访问的地址；证书、nginx server_name 都用它）
WB_SKY_DOMAIN=beta.admin.xyz
# 面板域名（可选；不给公网开放就用 SSH 隧道，见 README）
WB_SKY_LIVE_DOMAIN=live.admin.xyz
# 管理后台域名（**可写后台**，可选）。
# 留空 = 不装这个站点的反代（推荐：直接走 SSH 隧道访问 127.0.0.1:2999/admin）。
# 要填的话请务必先改掉 WB_SKY_ADMIN_PASSWORD，并在 1Panel 里再套一层 Basic 认证。
WB_SKY_ADMIN_DOMAIN=

# ★★ 这里是整套部署**最容易搞错、也最难查出原因**的一项 ★★
# 下发给客户端的联机地址（房间服的 host）。
#   · 必须是**公网 IPv4**，例如 103.24.218.98
#   · ❌ 不要写域名：客户端实时层会因为结果不是 IPv4 而断言崩溃
#   · ❌ 不要写 127.0.0.1 / 内网地址：玩家根本连不到
# 填错的症状：能登录、能进图，但**看不到其他玩家**，而且日志里一句错都没有。
WB_SKY_UDP_HOST=103.24.218.98
# 端口不用在这里再写一遍：容器里的 WB_SKY_UDP_PORT 由 compose 从上面
# 的 UDP_PORT 推导，避免同一个值两处维护、改一处忘一处。


# ---------------------------------------------------------------------
# 三、生产保护 / 运行时开关（由 deploy/sitecustomize.py 读取）
# ---------------------------------------------------------------------
# 0（默认）= 强制关掉 Werkzeug 调试器与重载器。
#            源码里写的是 debug=True，公网跑会暴露 /console 交互式调试器
#            （等于把服务器交出去），重载器还会 fork 第二个进程抢端口。
# 1         = 保留源码原行为，仅本机排障用。
WB_SKY_DEBUG=0

# 监听地址。默认 0.0.0.0（容器里必须这样）。
WB_SKY_BIND=0.0.0.0

# 实时面板 /live 的登录口令。
# ⚠️ 源码 live_panel.py 里硬编码的是 admin/admin123，等于把后台口令
#    写进了部署包。这里改掉才会覆盖源码值 —— **上线前请务必改掉**。
WB_SKY_LIVE_USER=admin
WB_SKY_LIVE_PASSWORD=admin123

# ---------------------------------------------------------------------
# 管理后台 /admin（账号 / 货币 / 解锁 / 好友 / 动态）
# ---------------------------------------------------------------------
# 与 /live 的分工：/live 只看"现在"（在线、房间、位置、聊天，只读）；
# /admin 改数据（可写）。两个面板各自独立鉴权，互不影响。
#
# ⚠️ 口令**必须改**：默认就是 admin/admin123。
#    面板没有 CSRF token，设计上只给内网 / SSH 隧道用，不要直接暴露公网。
#    推荐用法（隧道）：
#        ssh -L 2007:127.0.0.1:2007 root@103.24.218.98
#        然后本机开 http://127.0.0.1:2007/admin
WB_SKY_ADMIN_USER=admin
WB_SKY_ADMIN_PASSWORD=admin123
# 1 = 开启 /admin（默认）；0 = 整个面板下线（访问直接 404）
WB_SKY_ADMIN_ENABLED=1
# 免登录时长（分钟），默认 720 = 12 小时
WB_SKY_ADMIN_SESSION_MINUTES=720

# ---------------------------------------------------------------------
# 好友默认昵称池
# ---------------------------------------------------------------------
# 没名字的好友不再显示成"对方 uuid 前 8 位"，而是从
# wbsky/config/friend_name_pool.json（528 个名字）里随机取一个**并落库**，
# 所以刷新/重登都是同一个名字。
# 1 = 开启（默认）；0 = 回到老行为（uuid 前 8 位）
WB_SKY_FRIEND_RANDOM_NAME=1
# 生成的默认名几个字：1 = 单字（如「浩」），2 = 双字（如「浩文」）
WB_SKY_FRIEND_NAME_LEN=1

# 连不上数据库时不要整个服务崩掉：重试 WB_SKY_DB_RETRY 次后只记日志继续跑。
# 为什么重要：index.py 的 database.init_db() 是**模块级**调用，原来没有
# try/except —— MySQL 一挂，异常直接冒到顶层，进程退出，被 restart 策略
# 无限重启，**连 UDP 联机服都一起起不来**，而联机本来跟数据库无关。
# 设 0 可回到"连不上就退出"的原行为。
WB_SKY_SCHEMA_RESILIENT=1
WB_SKY_DB_RETRY=3

# 放行私网来源访问 /internal/rtt（房间服在另一个容器时源 IP 是 compose 网段）
WB_SKY_TRUST_RFC1918=1

# 没放证书时是否让 entrypoint 自动签一张自签证书。
# 0 = 不加证书，主服务跑明文 HTTP（老包的原有行为，客户端能正常连）
# 1 = 自动签（客户端在 TLS 层跳过校验，自签够用）
WB_SKY_AUTO_CERT=0
WB_SKY_CERT_CN=beta.admin.xyz
WB_SKY_CERT_IP=103.24.218.98

# 下发聊天 WebSocket 地址。
# 留空 = 按客户端实际访问的地址拼（直连场景最合适）。
# 走 nginx 反代 https://beta.admin.xyz/account/ws 时，nginx 会把
# /account/ws 转给 ws 容器，这里留空即可。
WB_SKY_WS_URL=


# ---------------------------------------------------------------------
# 四、MySQL（用 1Panel 应用商店里装的 MySQL，不重复装一份）
# ---------------------------------------------------------------------
# 1 = 用 MySQL（推荐：1Panel 里好备份、好图形化管理）
# 0 = 用项目内的 SQLite 文件（wbsky/db/users.db，便于回滚/试跑）
#     （本包已修掉 SQLite 建表语句里的 MySQL 专有写法，
#       设 0 也能正常建出 12 张表；老包里设 0 会一张都建不出来）
#
# ★ MYSQL_HOST 该填什么（这条踩过，重点看）：
#   跑在**容器**里（本 compose）→ host.docker.internal
#      （compose 里已配 extra_hosts: host-gateway，它指向宿主机）
#   跑在**宿主机**上（原生部署）→ 127.0.0.1
#   千万**不要**填 mysql！那是 compose 服务名，只有 MySQL 也在同一个
#      compose 里时才解析得到；而 1Panel 的 MySQL 是**单独装的应用容器**，
#      不在这个网络里，填了会报：
#        Can't connect to MySQL server on 'mysql'
#        ([Errno -3] Temporary failure in name resolution)
WB_SKY_USE_MYSQL=1
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306

# 库名 / 账号 / 密码。
#   MYSQL_DATABASE  库名 = **skygame**（1Panel 里建库时用这个名字，字符集 utf8mb4）
#   MYSQL_USER      账号 = wbsky（**库名和账号是两回事**，可以不同名）
# 老机器上的数据在 wbsky 库，迁移时要么在 1Panel 里把库改名/改名导入，
# 要么跑一遍 mysqldump 再导进 skygame（见 docs/迁移与回滚.md）。
# ⚠️ 密码里带 @ # 等特殊字符**不用自己转义**，原样写即可。
MYSQL_USER=wbsky
MYSQL_PASSWORD=SkyServer2026!
MYSQL_DATABASE=skygame
MYSQL_CHARSET=utf8mb4

# 房间服依赖的 npm 源（容器首次启动 npm install 时用）。
# 国内机器访问官方 registry.npmjs.org 经常超时，而房间服依赖是**容器首次启动现场装**的，
# 装不上就等于联机服务起不来。官方源：https://registry.npmjs.org
# （宿主机手动跑 npm install 时以 sky0155-udp/.npmrc 为准）
NPM_REGISTRY=https://registry.npmmirror.com

# 部署时是否顺便把 db/wbsky-full.sql.gz 导进去（deploy/db-import.sh 用）
# 0 = 不动数据库（**已有数据的线上机器必须用 0**）
# 1 = 导入（空库首次部署时用；脚本会先确认库是空的，非空会拒绝执行）
SKYWB_DB_IMPORT=0

# 导入用的管理员账号（只有 SKYWB_DB_IMPORT=1 时才用到）
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=


# ---------------------------------------------------------------------
# 五、杂项
# ---------------------------------------------------------------------
TZ=Asia/Shanghai
