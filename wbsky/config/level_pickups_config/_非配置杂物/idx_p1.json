        "ok": True,
        "permanent": True,
        "expire_at": 0,
        "remain": 0,
        "msg": "校验已关闭",
        "bypass": True,
    })


@app.route("/key/unbind", methods=["POST", "GET"])
def license_removed_unbind():
    return jsonify({"ok": True, "msg": "卡密系统已移除"})


